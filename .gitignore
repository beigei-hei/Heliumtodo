# ── 构建产物 ───────────────────────────────────────────────
bin/
obj/
*.user
*.suo

# ── 打包出来的可分发版本（体积大、可重建，不进 Git）─────────
dist/

# ── IDE ───────────────────────────────────────────────────
.vs/
.idea/
*.DotSettings.user

# ── 运行时数据（真实数据库 / 配置 / 备份，属于用户数据）─────
Data/
backups/
*.db
*.db-wal
*.db-shm

# ── 自检与截图留下的临时物 ────────────────────────────────
output/
_probe-*/
.tmp-*/
*.tmp

# ── 文档截图保留，但渲染中间产物不留 ──────────────────────
docs/_shots/

