<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HeliumTodo.Data —— 本地存储层
    用 EF Core + SQLite 把 Core 里的模型存到本地文件。
    只依赖 Core，不依赖界面。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HeliumTodo.Data</RootNamespace>
    <AssemblyName>HeliumTodo.Data</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HeliumTodo.Core\HeliumTodo.Core.csproj" />
  </ItemGroup>

</Project>
