<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HeliumTodo.Core —— 领域内核
    只放「与界面、数据库无关」的纯逻辑：
      · 数据模型（日程 / 待办 / 专注 / 自习室）
      · 冲突检测算法（每日工作流的基础）
      · 扩展点接口（主题、插件）
    不引用 Avalonia，也不引用 EF Core —— 这样单元测试跑得飞快，也方便以后换界面框架。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HeliumTodo.Core</RootNamespace>
    <AssemblyName>HeliumTodo.Core</AssemblyName>
  </PropertyGroup>

</Project>
