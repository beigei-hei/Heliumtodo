<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HeliumTodo.Infrastructure —— 基础设施层
    用 EF Core + SQLite 把 Domain 里的模型存到本地文件。
    只依赖 Domain / Application，不依赖界面。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HeliumTodo.Infrastructure</RootNamespace>
    <AssemblyName>HeliumTodo.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HeliumTodo.Application\HeliumTodo.Application.csproj" />
    <ProjectReference Include="..\HeliumTodo.Domain\HeliumTodo.Domain.csproj" />
  </ItemGroup>

</Project>
