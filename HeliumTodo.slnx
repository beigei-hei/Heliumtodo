
<Solution>

  <!-- 领域：纯 BCL 的模型、规则与算法，不依赖界面框架 -->
  <Folder Name="/领域/">
    <Project Path="HeliumTodo.Domain/HeliumTodo.Domain.csproj" />
  </Folder>

  <!-- 应用：vibecoding时所划定的规定，只依赖 Domain -->
  <Folder Name="/应用/">
    <Project Path="HeliumTodo.Application/HeliumTodo.Application.csproj" />
  </Folder>

  <!-- 数据库：EF Core + PostgreSQL -->
  <Folder Name="/数据库/">
    <Project Path="HeliumTodo.Infrastructure/HeliumTodo.Infrastructure.csproj" />
  </Folder>

  <!-- 程序主体：Avalonia + FluentAvaloniaUI -->
  <Folder Name="/程序主体/">
    <Project Path="HeliumTodo.Desktop/HeliumTodo.Desktop.csproj" />
  </Folder>
  
  <!-- 测试与自检工具 -->
  <Folder Name="/测试/">
    <Project Path="HeliumTodo.Tests/HeliumTodo.Tests.csproj" />
    <Project Path="HeliumTodo.SelfTest/HeliumTodo.SelfTest.csproj" />
  </Folder>

  <!-- 界面渲染自检：不开窗口也能把页面渲染成图片 -->
  <Folder Name="/工具/">
    <Project Path="HeliumTodo.Verification/HeliumTodo.Verification.csproj" />
  </Folder>

</Solution>
