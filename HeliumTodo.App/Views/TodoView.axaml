<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeliumTodo.App.ViewModels"
             xmlns:core="using:HeliumTodo.Core.Models"
             xmlns:controls="using:HeliumTodo.App.Controls"
             x:Class="HeliumTodo.App.Views.TodoView"
             x:DataType="vm:TodoViewModel">

  <!--
    待办事项（改版后）

    ┌──────────────────────────────────────────────────────────┐
    │ 待办事项                        4 未完成 · 2 今天 · 9 全部│  ← 卡片头
    ├──────────────────────────────────────────────────────────┤
    │ 要做点什么？                                    [更多] 保存│  ← 快速添加行（无边框）
    ├──────────────────────────────────────────────────────────┤
    │ 未完成 今天 已完成 全部            搜索…          共 4 条 │  ← 筛选行
    ├──────────────────────────────────────────────────────────┤
    │ ☐ 高  写数据结构实验报告             安排时间 ✏ 🗑        │  ← 列表
    │ ☐ 中  复习线代                                            │
    └──────────────────────────────────────────────────────────┘

    三个决定：
      ① **没有页面大标题**。标题就是卡片头那一行 16px —— 页面上只有一张卡，
         再顶一个大标题等于同一句话说两遍。
      ② **快速添加行不画边框**。输入框本身就是这行唯一的东西，
         再套一层 Border 会让人以为「要点进去才能输入」。
      ③ **高级字段收进「更多」**。改版前新建区一直摊着两行控件，
         把列表挤到屏幕下半截；而 80% 的时候用户只想写一句话就回车。
  -->

  <!--
    页面分区统一模板（以今日工作流为模板）：
      第 0 行 = 模块名称那一行（标题 + 概览/动作），独立在功能区外面；
      第 1 行 = 功能区（卡片）。

    为什么标题不再写进卡片头：
      卡片头属于「卡片的边框」，标题应该属于「页面」。标题留在卡片里，
      页面顶部就永远是卡片的圆角，而不是这块区域的起点；而且六个页面
      各自把标题塞在卡片的不同位置，切换页面时标题会上下跳。
  -->

  <Grid RowDefinitions="Auto,*" Margin="12,4,12,12">

    <!-- ══════════════════ 顶部：模块名称 ══════════════════ -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" MinHeight="40" Margin="4,0,4,20">
      <TextBlock Grid.Column="0" Text="待办事项" Classes="pageHeader"
                 VerticalAlignment="Center" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14"
                  VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="{Binding ActiveCount}" Classes="pageMetric" />
          <TextBlock Text="未完成" Classes="pageCaption" VerticalAlignment="Center"
                     Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="{Binding CompletedTodayCount}" Classes="pageMetric" />
          <TextBlock Text="今天完成" Classes="pageCaption" VerticalAlignment="Center"
                     Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="{Binding TotalCount}" Classes="pageMetric" />
          <TextBlock Text="全部" Classes="pageCaption" VerticalAlignment="Center"
                     Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ══════════════════ 功能区：一张卡 ══════════════════ -->
    <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
      <Grid RowDefinitions="Auto,Auto,*">

        <!-- ══════════ 快速添加行 ══════════ -->
        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardInsetBrush}">
          <StackPanel Margin="20,10" Spacing="10">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <!-- 输入框去边框、透明底：让它看起来就是"这一行本身" -->
              <TextBox Grid.Column="0"
                       Text="{Binding NewTitle}"
                       PlaceholderText="要做点什么？例如：写数据结构实验报告"
                       AcceptsReturn="False"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0"
                       MinHeight="34"
                       VerticalContentAlignment="Center" />

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="MoreToggle" Content="更多" FontSize="12" Padding="10,4"
                              ToolTip.Tip="优先级 / 分类 / 预计时长 / 截止时间" />
                <Button Content="取消" Command="{Binding CancelEditCommand}"
                        IsVisible="{Binding IsEditing}" />
                <Button Content="保存" Classes="accent"
                        Command="{Binding SaveCommand}" />
              </StackPanel>
            </Grid>

            <!-- 高级字段：默认收起。绑定到上面那个 ToggleButton，不用额外的 VM 属性。 -->
            <WrapPanel Orientation="Horizontal" ItemWidth="NaN"
                       IsVisible="{Binding #MoreToggle.IsChecked}">

              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,6">
                <TextBlock Text="优先级" Classes="caption" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding PriorityOptions}"
                          SelectedItem="{Binding NewPriority}" MinWidth="86">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="core:Priority">
                      <TextBlock Text="{Binding Converter={StaticResource PriorityText}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,6">
                <TextBlock Text="分类" Classes="caption" VerticalAlignment="Center" />
                <!--
                  Avalonia 11 的下拉框不支持「可以自己输入」，
                  所以这里用「输入框 + 常用分类快选按钮」的组合，
                  既能自由填写，也能一键选常用分类。
                -->
                <TextBox Text="{Binding NewCategory}" MinWidth="96"
                         PlaceholderText="分类" ToolTip.Tip="可以自己填，也可以点右面的常用分类" />
                <Button Content="学习" FontSize="10" Padding="6,2" Tag="学习"
                        Click="OnCategoryPresetClick" />
                <Button Content="生活" FontSize="10" Padding="6,2" Tag="生活"
                        Click="OnCategoryPresetClick" />
                <Button Content="社团" FontSize="10" Padding="6,2" Tag="社团"
                        Click="OnCategoryPresetClick" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,6">
                <TextBlock Text="预计" Classes="caption" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding NewEstimatedMinutes}" Minimum="5" Maximum="600"
                               Increment="5" FormatString="0" MinWidth="104" />
                <TextBlock Text="分钟" Classes="caption" VerticalAlignment="Center" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                <CheckBox Content="截止" IsChecked="{Binding NewHasDueTime}"
                          VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding NewDueDate}"
                            IsEnabled="{Binding NewHasDueTime}" />
                <TimePicker ClockIdentifier="24HourClock"
                            SelectedTime="{Binding NewDueTime}"
                            IsEnabled="{Binding NewHasDueTime}" />
              </StackPanel>

              <!-- 提醒：和日程页共用同一个选择器 -->
              <controls:ReminderPicker DataContext="{Binding Reminder}" />
            </WrapPanel>

            <!-- 编辑模式下提示「正在改哪一条」，普通添加时留空不占视觉 -->
            <TextBlock Text="{Binding EditorTitle}" Classes="caption"
                       IsVisible="{Binding IsEditing}" />
          </StackPanel>
        </Border>

        <!-- ══════════ 筛选行 ══════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,10">

          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
            <RadioButton Content="未完成" GroupName="filter" FontSize="12"
                         IsChecked="{Binding IsFilterActive, Mode=OneWay}"
                         Command="{Binding SetFilterCommand}" CommandParameter="Active" />
            <RadioButton Content="今天" GroupName="filter" FontSize="12"
                         IsChecked="{Binding IsFilterToday, Mode=OneWay}"
                         Command="{Binding SetFilterCommand}" CommandParameter="Today" />
            <RadioButton Content="已完成" GroupName="filter" FontSize="12"
                         IsChecked="{Binding IsFilterCompleted, Mode=OneWay}"
                         Command="{Binding SetFilterCommand}" CommandParameter="Completed" />
            <RadioButton Content="全部" GroupName="filter" FontSize="12"
                         IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                         Command="{Binding SetFilterCommand}" CommandParameter="All" />
          </StackPanel>

          <TextBox Grid.Column="1" Text="{Binding SearchText}"
                   PlaceholderText="搜索标题 / 分类 / 备注…" MaxWidth="260" MinHeight="30"
                   HorizontalAlignment="Right" />

          <TextBlock Grid.Column="2" Text="{Binding Items.Count, StringFormat='共 {0} 条'}"
                     Classes="caption" VerticalAlignment="Center" />
        </Grid>

        <!-- ══════════ 列表 ══════════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
          <StackPanel>
            <TextBlock Text="{Binding EmptyHint}" Classes="caption" Margin="12,16,0,0"
                       IsVisible="{Binding !Items.Count}" />

            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="core:TodoItem">
                   <!-- 已完成的整行淡下去（0.55），未完成保持 1 —— 见 App.axaml 里的 CompletedToOpacity -->
                   <Border Classes="listRow"
                          Opacity="{Binding IsCompleted, Converter={StaticResource CompletedToOpacity}}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">

                      <!-- 勾选完成 -->
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}"
                                VerticalAlignment="Center"
                                Command="{Binding $parent[ItemsControl].((vm:TodoViewModel)DataContext).ToggleCommand}"
                                CommandParameter="{Binding}" />

                      <!-- 优先级标签（点一下升一级） -->
                      <Button Grid.Column="1" Padding="0" Background="Transparent"
                              BorderThickness="0" VerticalAlignment="Center"
                              ToolTip.Tip="点一下调整优先级"
                              Command="{Binding $parent[ItemsControl].((vm:TodoViewModel)DataContext).CyclePriorityCommand}"
                              CommandParameter="{Binding}">
                        <Border Classes="chip"
                                Background="{Binding Priority, Converter={StaticResource PriorityBrush}}"
                                BorderBrush="{Binding Priority, Converter={StaticResource PriorityBrush}, ConverterParameter=Border}"
                                BorderThickness="1">
                          <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityText}}"
                                     Foreground="{Binding Priority, Converter={StaticResource PriorityBrush}, ConverterParameter=Text}" />
                        </Border>
                      </Button>

                      <!-- 标题 + 附加信息 -->
                      <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <!-- 截止时间：逾期会标红 -->
                          <StackPanel Orientation="Horizontal" Spacing="3"
                                      IsVisible="{Binding DueAt, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="&#xE823;" FontFamily="{DynamicResource IconFont}"
                                       FontSize="11" VerticalAlignment="Center" Opacity="0.7" />
                            <TextBlock Classes="caption" VerticalAlignment="Center"
                                       Text="{Binding DueAt, StringFormat='{}{0:MM-dd HH:mm}'}" />
                            <TextBlock Text="已逾期" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ConflictErrorBrush}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsOverdue}" />
                          </StackPanel>

                          <!-- 已安排到时间轴 -->
                          <StackPanel Orientation="Horizontal" Spacing="3"
                                      IsVisible="{Binding PlannedStart, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="&#xE787;" FontFamily="{DynamicResource IconFont}"
                                       FontSize="11" VerticalAlignment="Center" Opacity="0.7" />
                            <TextBlock Classes="caption" VerticalAlignment="Center"
                                       Text="{Binding PlannedStart, StringFormat='已安排 {0:MM-dd HH:mm}'}" />
                          </StackPanel>

                          <!-- 累计专注时长 -->
                          <StackPanel Orientation="Horizontal" Spacing="3"
                                      IsVisible="{Binding FocusedDuration, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="&#xE916;" FontFamily="{DynamicResource IconFont}"
                                       FontSize="11" VerticalAlignment="Center" Opacity="0.7" />
                            <TextBlock Classes="caption" VerticalAlignment="Center"
                                       Text="{Binding FocusedDuration, StringFormat='已专注 {0:hh\\:mm}'}" />
                          </StackPanel>

                          <TextBlock Classes="caption" VerticalAlignment="Center"
                                     Text="{Binding Category}"
                                     IsVisible="{Binding Category, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                      </StackPanel>

                      <!-- 操作按钮 -->
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                  VerticalAlignment="Center">

                        <!-- 安排 / 取消安排时间：这是「待办 → 时间轴」的开关 -->
                        <Button Content="安排时间" FontSize="11" Padding="8,4"
                                IsVisible="{Binding !IsScheduled}"
                                Command="{Binding $parent[ItemsControl].((vm:TodoViewModel)DataContext).ScheduleCommand}"
                                CommandParameter="{Binding}" />
                        <Button Content="取消安排" FontSize="11" Padding="8,4"
                                IsVisible="{Binding IsScheduled}"
                                Command="{Binding $parent[ItemsControl].((vm:TodoViewModel)DataContext).UnscheduleCommand}"
                                CommandParameter="{Binding}" />

                        <Button FontSize="12" Padding="8,4" ToolTip.Tip="编辑"
                                Command="{Binding $parent[ItemsControl].((vm:TodoViewModel)DataContext).EditCommand}"
                                CommandParameter="{Binding}">
                          <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                        </Button>
                        <Button FontSize="12" Padding="8,4" ToolTip.Tip="删除"
                                Command="{Binding $parent[ItemsControl].((vm:TodoViewModel)DataContext).DeleteCommand}"
                                CommandParameter="{Binding}">
                          <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Border>
  </Grid>
</UserControl>