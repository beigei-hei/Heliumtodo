<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    ══════════════════════════════════════════════════════════════
      NuGet 还原配置
    ══════════════════════════════════════════════════════════════

    正常情况下，nuget.org 是唯一需要的包源，不用改这个文件。

    这里额外加了「本地缓存」作为兜底来源：
      所有下载过的包都会留在 C:\Users\<你>\.nuget\packages 里。
      把那个文件夹也当成一个包源，就能在没网的时候完成还原
      （例如在飞机上、或者校园网限制访问 nuget.org 的时候）。

    如果换了电脑、路径不一样，只要把下面 globalPackagesFolder 那行的
    用户名改掉，或者干脆把 <packageSources> 里的 local-cache 整段删掉。
  -->
  <config>
    <add key="globalPackagesFolder" value="%USERPROFILE%\.nuget\packages" />
  </config>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-cache" value="%USERPROFILE%\.nuget\packages" />
  </packageSources>

</configuration>
