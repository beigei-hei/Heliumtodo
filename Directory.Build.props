<Project>

  <!--
    全局编译设置（所有子项目共享）。
    这里是「统一版本号 / 统一语言特性」的地方，改一处就影响整个解决方案。
  -->
  <PropertyGroup>
    <!--
      版本号：开发阶段。
        0.5.0-alpha
        │ │ │ └── 预发布标记：alpha = 内测版（比 dev 稳一点，功能还可能变）
        │ │ └──── 修订号：修 bug、微调
        │ └────── 次版本号：加功能
        └──────── 主版本号：大改版

      注意版本号里用 -alpha 而不是 .alpha：
        这是语义化版本（SemVer）的写法。NuGet 和 .NET 的打包工具都只认
        「数字.数字.数字-预发布标记」这种格式，写成 0.5.0.alpha 会被判为非法版本号。
        想显示成「0.5.0.alpha」的话，那属于界面上怎么展示的问题，改界面文字就行，
        但这里（程序集版本）必须是合法格式。
    -->
    <Version>0.5.0-alpha</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>

    <!-- 产品信息 -->
    <Product>Helium Todo</Product>
    <Company>Helium</Company>
    <Copyright>Copyright (c) 2025 Helium Todo contributors</Copyright>

    <!-- 语言特性：C# 14（.NET 10 默认）+ 可空引用类型（写代码时能提前发现 null 问题） -->
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      不让警告挡住编译，但会把警告打出来提醒。

      NU1900 = 「取不到包漏洞数据」。离线沙箱里 nuget.org 不可达时每次还原都会记一条，
      它会一直从 project.assets.json 里被重放到构建输出，把「0 警告」门禁弄脏。
      只屏蔽这一条「数据源不可达」，真实的漏洞警告（NU1901–NU1904）仍然会报。
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- 关闭 .NET 遥测，减少编译时的卡顿 -->
    <DOTNET_CLI_TELEMETRY_OPTOUT>true</DOTNET_CLI_TELEMETRY_OPTOUT>
    <DOTNET_NOLOGO>true</DOTNET_NOLOGO>
  </PropertyGroup>

  <!--
    集中管理 NuGet 包版本（中央包版本管理）。
    好处：升级 Avalonia 时只要改这里的数字，不用去翻每个 .csproj。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
