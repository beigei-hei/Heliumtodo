<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HeliumTodo.Verification —— 界面渲染自检

    它做什么？
      用 Avalonia 的「无头」模式（不弹真窗口）把每个页面渲染一遍，
      然后把结果存成 PNG 图片。

    为什么要这个？
      · 编译通过 ≠ 界面能正常显示。绑定写错、资源找不到、布局崩了，
        这些问题只有真的渲染一次才会暴露出来。
      · 在没有桌面的环境（CI 服务器、远程终端）里，它照样能跑。
      · 生成的图片可以直接用眼睛看，比读日志快得多。

    用法（在解决方案根目录执行）：
      dotnet run 加上 -project 参数，指向 HeliumTodo.Verification
      图片会输出到 output/render 文件夹
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HeliumTodo.Verification</RootNamespace>
    <AssemblyName>HeliumTodo.Verification</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!--
      Avalonia 12 把文字排版（HarfBuzz 整形）拆成了独立包。
      Avalonia 11 时代它埋在 Skia 里，所以老代码里看不到这个引用。
    -->
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- 直接引用界面工程，这样渲染的就是「真正要发布的那个界面」 -->
    <ProjectReference Include="..\HeliumTodo.Application\HeliumTodo.Application.csproj" />
    <ProjectReference Include="..\HeliumTodo.Desktop\HeliumTodo.Desktop.csproj" />
    <ProjectReference Include="..\HeliumTodo.Domain\HeliumTodo.Domain.csproj" />
  </ItemGroup>

</Project>
