<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      ⚠️ 这一项必须是 true，否则上面的 PackageVersion 对【传递依赖】不生效。

      踩过的坑：本来是 false，以为在 PackageVersion 里写
      「Avalonia.Controls.DataGrid 12.1.2」就能把它提上去，结果提不上去。
      因为 false 的含义是「中央版本只用于直接引用的包」；
      当时的 DataGrid 是 FluentAvaloniaUI 拖进来的间接依赖，不归它管。

      症状：输出目录里只有 DataGrid 是旧版本、其余全是新版本。
      这种混版会让 IDE 的语法分析跨版本解析类型时出错
      （表现就是莫名其妙标红，但编译能过），运行时也可能加载失败。

      改成 true 之后，中央版本对传递依赖同样有约束力，整棵树就统一了。
      0.5.0 P4 删掉 FluentAvaloniaUI 后，DataGrid 也不再出现在依赖树里。
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ===== 界面：Avalonia 12 =====

      Avalonia 12.1.5 是 0.5.0 的目标版本。升级时一定要去 NuGet 索引
      逐个核对子包可用版本，不能假设所有包同步发版（DataGrid 就只发到 12.1.2，
      FluentAvaloniaUI 删除后我们不再依赖它）。
    -->
    <PackageVersion Include="Avalonia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.5" />

    <!--
      Avalonia 12 把文字排版（HarfBuzz 整形）拆成了独立包，
      不显式引用的话运行时会在渲染文字时找不到实现。
      Avalonia 11 时代它埋在 Skia 包里，不需要单独引用。
    -->
    <PackageVersion Include="Avalonia.HarfBuzz" Version="12.1.5" />

    <!--
      我们可以不直接用，但 FluentAvalonia 的颜色选择器需要它；
      显式钉住避免传递依赖挑到别的版本。升级 Avalonia 时同步改这一行。
    -->
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.1.5" />

    <!-- 无头渲染：不开窗口也能把界面渲染成图片，用来自动检查界面有没有画错 -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.5" />

    <!--
      ===== 设计系统：FluentAvalonia（0.5.0-alpha 热修 2 起）=====

      Material.Avalonia 3.21 在 0.5.0 开发期试用过，但小尺寸按钮、下拉框与
      设置页的观感明显不如原有的 Fluent 主题，用户要求按显示效果切回。
      FluentAvaloniaUI 3.1.0 依赖 Avalonia 12.1.0，在 12.1.5 下兼容。
      DataGrid 只发到 12.1.2（FA 的传递依赖），在这里钉住避免混版。
    -->
    <PackageVersion Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />

    <!--
      ===== 交互行为：Xaml.Behaviors（0.5.0 P5）=====

      旧包名 Avalonia.Xaml.Behaviors 只发到 11.3.0.6（依赖 Avalonia 11.3.0，
      在 Avalonia 12 上挂 BehaviorCollection 会 TypeLoadException）。
      上游把 12.x 改成了新包名 Xaml.Behaviors.Avalonia（12.1.5，依赖 Avalonia 12.1.5），
      这是一组 meta 包，含 Interactivity / Interactions.* / Animations。
    -->
    <PackageVersion Include="Xaml.Behaviors.Avalonia" Version="12.1.5" />

    <!--
      ===== 图片解码：SkiaSharp =====

      为什么要显式引用它？
        它是 Avalonia.Skia 拖进来的传递依赖（版本 3.119.4），
        我们本来不需要单独写。但壁纸功能要【自己】解码 APNG / GIF 的每一帧，
        得直接用它的 API，所以必须显式引用才能拿到编译期的类型。

      ⚠️ 版本必须和 Avalonia 12.1.5 依赖的那个版本【完全一致】。
         写高了或写低了，输出目录里就会出现两个不同版本的 libSkiaSharp.dll，
         运行时挑哪个看加载顺序，表现是"有时候图片显示不出来"这种随机崩溃。
         查当前版本的办法：dotnet list 看传递依赖里的 SkiaSharp 那一行。
    -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />

    <!-- ===== MVVM 工具包：源生成器写法，省掉大量样板代码 ===== -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- ===== 数据库：EF Core + PostgreSQL ===== -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <!--
      Npgsql 10.0.3 声明依赖 EF Core Relational 10.0.4，而主包是 10.0.14。
      不显式钉这一行的话 MSB3277 会挑 10.0.4 当"主版本"，
      运行期加载的 Relational 比编译期旧，Npgsql 的查询会抛 MissingMethodException。
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />

    <!-- ===== 依赖注入 / 日志 ===== -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14" />

    <!-- ===== 测试 ===== -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    升级 Avalonia 之后怎么检查有没有混版？

      用 dotnet list 命令列出传递依赖（开关名见下面那行纯文本），
      输出里所有 Avalonia 开头的程序集版本号应该完全一致。

    开关名的写法：include 前面加两个减号，再写 transitive。
    （之所以不直接写出来，是因为 XML 注释里禁止连续两个减号。）
  -->

</Project>