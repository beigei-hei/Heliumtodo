<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Heliumtodo.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Heliumtodo.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Heliumtodo 主界面"
       >
        

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
<StackPanel>
    <Border Margin="5" CornerRadius="3" Width="200" HorizontalAlignment="Left" Background="AliceBlue">
        <TextBlock Margin="5"
               FontSize="20" 
               HorizontalAlignment="Center" 
               Text="摄氏温度转换器">
               
        </TextBlock>
        
    </Border>
     <Grid ShowGridLines="False" Margin="5" 
        ColumnDefinitions="120, 100"
        RowDefinitions="Auto, Auto, Auto" >
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="10">摄氏度</TextBlock>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0 5" TextChanged="摄氏度_TextChanged" Text="0" Name="摄氏度"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Margin="10">华氏度</TextBlock>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0 5" Text="" Name="华氏度" IsReadOnly="True"/>
    </Grid>


   

    
    



</StackPanel>
    
    
    

</Window>
