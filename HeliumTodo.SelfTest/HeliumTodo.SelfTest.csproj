<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HeliumTodo.SelfTest —— 不需要测试框架的测试运行器

    为什么需要它？
      正常的 `dotnet test` 要启动一个「测试宿主进程」，再由它去附加到父进程上。
      这在某些受限环境（沙箱、精简的 CI 容器）里会被系统拒绝，报「拒绝访问」。
      这个小工具改成用「反射」直接调用测试方法，不启动任何额外进程，
      因此在任何环境下都能跑。

    用法（在解决方案根目录执行）：
      dotnet run 加上 -project 参数，指向 HeliumTodo.SelfTest

    注意：它和 HeliumTodo.Tests 用的是<b>同一批测试代码</b>，不是另写一份。
      所以你在 Visual Studio 里用「测试资源管理器」跑，和用这个跑，结果是一样的。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HeliumTodo.SelfTest</RootNamespace>
    <AssemblyName>HeliumTodo.SelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HeliumTodo.Core\HeliumTodo.Core.csproj" />
    <ProjectReference Include="..\HeliumTodo.Tests\HeliumTodo.Tests.csproj" />
  </ItemGroup>

</Project>
