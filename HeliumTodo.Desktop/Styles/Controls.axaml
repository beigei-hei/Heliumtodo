<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >

  <!--
    ══════════════════════════════════════════════════════════════════════════
      通用控件样式
    ══════════════════════════════════════════════════════════════════════════
      这里只放「多个页面都要用」的样式。
      命名规律：
        .card       卡片容器
        .section    区域标题
        .pageTitle  页面大标题
        .caption    辅助小字
        .metric     统计数字
        .timelineEntry / .timelineEntryInner  时间轴上的条目
    ══════════════════════════════════════════════════════════════════════════
  -->

  <!-- 全局字体 -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
  </Style>
  <Style Selector="UserControl">
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
  </Style>

  <!--
    ───────────── 卡片头 ─────────────
    改版后页面不再有 28px 的大标题：标题就长在卡片头上（16 / SemiBold）。
    为什么这么改：大标题占一整行高度却只提供一个词，
    而卡片头那行本来就要放标题 —— 两处写同一句话是纯浪费。
  -->
  <Style Selector="TextBlock.cardHeader">
    <Setter Property="FontSize" Value="{DynamicResource FontSubtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--
    ───────────── 页面标题行（六个页面共用，2026-11-02 统一） ─────────────
    模块名那一行独立在功能区外面，字号比卡片头大两档：
      标题 24（SemiBold）、概览/字幕 15、概览数字 24。
    比卡片头（16）大是因为它代表"整个页面"，而卡片头只代表"一张卡"；
    只大一档（20）时在 1400 宽的窗口里仍然"缩"在左上角，看不出来是个页面标题。
  -->
  <Style Selector="TextBlock.pageHeader">
    <Setter Property="FontSize" Value="{DynamicResource FontTitleLarge}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.pageCaption">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Opacity" Value="0.62" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.pageMetric">
    <Setter Property="FontSize" Value="{DynamicResource FontTitleLarge}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ───────────── 页面标题（改版后仅设置页等少数地方还在用） ───────────── -->
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="{DynamicResource FontTitleLarge}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style Selector="TextBlock.pageSubtitle">
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="Opacity" Value="0.65" />
    <Setter Property="Margin" Value="0,0,0,20" />
  </Style>

  <!-- ───────────── 区域标题 ───────────── -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource FontSubtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- 统计大数字 -->
  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="{DynamicResource FontDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ───────────── 调色板 ───────────── -->
  <!-- R / G / B 这三个通道字母 -->
  <Style Selector="TextBlock.channelLabel">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- 预设色块按钮：去掉按钮自己的背景，只留里面那个彩色小方块 -->
  <Style Selector="Button.swatch">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,0" />
    <Setter Property="Padding" Value="3,3,3,3" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
  </Style>

  <Style Selector="Button.swatch:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
  </Style>

  <!-- ───────────── 卡片 ───────────── -->
  <!--
    改版后的卡片是"浮在壁纸上的半透明板"：
      · 半透明表面（CardSurfaceBrush，80% 白 / 70% 深灰）——壁纸透上来一层
      · 1px 亮描边 ——在暗色壁纸上也能看出边界
      · 阴影 ——把卡片从壁纸上"托"起来，这是浮层感的关键
    背景关掉壁纸时，这层半透明会压在不透明的主题底色上，视觉上接近纯色卡片，
    所以不用为"有没有壁纸"写两套样式。
  -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    <Setter Property="ClipToBounds" Value="True" />
    <!--
      ⚠️ 这里必须写成 "16,16,16,16" 这种四个数的形式，不能写 {DynamicResource SpaceL}。
      原因：SpaceL 是个 Double，而 Padding 要的是 Thickness。
      样式里的 Double 不会被自动转成 Thickness —— 要到真正应用时才炸，报
        InvalidCastException: Unable to cast object of type 'System.Double' to type 'Avalonia.Thickness'
      这个坑很阴：以前所有用 card 的地方都自己又写了 Padding="14,12"，
      本地值优先级更高，坏掉的样式值根本轮不到转换，所以一直没暴发。
      直到这里出现一个不覆盖 Padding 的卡片才露出来。
    -->
    <Setter Property="Padding" Value="16,16,16,16" />
  </Style>

  <!-- 带强调色的卡片（用于「今日焦点」这类需要突出的区域） -->
  <Style Selector="Border.card.accent">
    <Setter Property="BorderThickness" Value="1,1,1,3" />
  </Style>

  <!-- ───────────── 时间轴条目 ───────────── -->
  <!--
    外层 Border 负责在 Canvas 上定位（位置和大小由转换器算出来），
    所以这里只设字号、内边距这些不影响定位的东西。
  -->
  <Style Selector="Border.timelineEntry">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- 内层容器：里面放标题和时间 -->
  <Style Selector="Border.timelineEntryInner">
    <Setter Property="Padding" Value="7,4,6,4" />
  </Style>

  <Style Selector="Border.timelineEntry TextBlock.entryTitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="Border.timelineEntry TextBlock.entryTime">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- 冲突条目的高亮外框 -->
  <Style Selector="Border.timelineEntry.conflict">
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!--
    ───────────── 时间轴上的空档 / 冲突标记 ─────────────
  -->
  <Style Selector="Border.conflictBand">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <!-- ───────────── 列表项 ───────────── -->
  <Style Selector="Border.listRow">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.listRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
  </Style>

  <!-- ───────────── 优先级标签 ───────────── -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusS}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ───────────── 左侧时间轴刻度 ───────────── -->
  <Style Selector="TextBlock.hourLabel">
    <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <!--
      宽度必须写死成左侧刻度列的宽度（46），否则 Canvas 只会给 TextBlock
      分配它「想要」的那点宽度，右对齐就无处可依，标签会跑到可视区域外面 —— 之前就是这个 bug。
      负的上边距是为了让文字的**中心**对准刻度线，而不是让文字顶部对齐刻度线。
    -->
    <Setter Property="Width" Value="46" />
    <Setter Property="Margin" Value="0,-8,6,0" />
  </Style>

  <!-- ───────────── 外壳：图标轨 ───────────── -->
  <!--
    图标轨上的按钮：44×44 的圆角方块，只放一个字形。
    尺寸和圆角都来自令牌（RailItemSize / RadiusRailItem），改一处就全变。
  -->
  <!-- 收起态：44×44 的方块（shell-check 钉着这个数）。
       展开态由 .expanded 覆盖成"跟着轨道拉伸"——整个展开过程只有轨道一条 Width
       在动，按钮是被动的，否则每帧会有 1 + N 条动画各自触发一次整页重排。 -->
  <Style Selector="Button.railItem">
    <Setter Property="Width" Value="{DynamicResource RailItemSize}" />
    <Setter Property="Height" Value="{DynamicResource RailItemSize}" />
    <Setter Property="Padding" Value="0" />
    <!-- 不许在横向上留边距：收起态这里必须是 44×44（shell-check 钉着），
         展开态按钮跟着轨道拉伸（宽度由轨道决定，见条目模板的 Stretch）。 -->
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusRailItem}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.railItem.expanded">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.railItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusRailItem}" />
  </Style>

  <Style Selector="Button.railItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="Button.railItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
  </Style>

  <!-- 选中：强调色实心块。剪影里的白色图标对比度最高，不用管深浅主题 -->
  <Style Selector="Button.railItem.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
  </Style>

  <Style Selector="Button.railItem.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <!-- 图标字形本身 -->
  <Style Selector="Button.railItem TextBlock.railGlyph">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="Button.railItem:pointerover TextBlock.railGlyph">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="Button.railItem.active TextBlock.railGlyph">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!--
    展开态旁边的名称。
    尺寸比 cardHeader 小一号：它是"导航项的名字"，不是页面标题；
    和 18pt 的字形并排放，13pt 的字更容易被读成"图标的说明"。
  -->
  <Style Selector="Button.railItem TextBlock.railLabel">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="Button.railItem:pointerover TextBlock.railLabel">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="Button.railItem.active TextBlock.railLabel">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!--
    轨道顶部的"展开 / 收起"按钮。
    做得比导航按钮矮一点、没有背景：它是个工具，不是目的地，
    挂在最上面但不该抢走"当前在哪一页"的注意力。
  -->
  <Style Selector="Button.railToggle">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="Button.railToggle /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
  </Style>

  <Style Selector="Button.railToggle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="Button.railToggle:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
  </Style>

  <Style Selector="Button.railToggle:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <!-- 键盘焦点：图标轨是自绘的，必须自己把焦点框画出来，否则纯键盘操作会迷路 -->
  <Style Selector="Button.railItem:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ───────────── 外壳：窗口按钮 ───────────── -->
  <!--
    46×32：比图标轨的方块扁一点，看着更像"窗口右上角那三个"。
    关闭按钮的悬停色必须是红的 —— 这是 Windows 上所有人都认得的手指记忆。
  -->
  <Style Selector="Button.windowButton">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="Button.windowButton /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusM}" />
  </Style>

  <Style Selector="Button.windowButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="Button.windowButton:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="Button.windowButton.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
  </Style>

  <Style Selector="Button.windowButton.close:pointerover">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- ───────────── 设置页 ───────────── -->
  <Style Selector="TextBlock.settingHeader">
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.settingDescription">
    <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!--
    设置页的分组行不许自己画底。
    0.4 时原因是 FASettingsExpanderItem 的控件主题写死了 #B3FFFFFF，
    每一行会各自刷一层白；P4 换成自绘 SettingsExpander 后模板本身就不带底色，
    这里不再需要 fa| 覆盖样式。
  -->

</Styles>
