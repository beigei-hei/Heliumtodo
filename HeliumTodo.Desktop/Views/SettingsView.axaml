<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeliumTodo.Desktop.ViewModels"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:ctl="using:HeliumTodo.Desktop.Controls"
             x:Class="HeliumTodo.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <!--
    页面分区统一模板（以今日工作流为模板）：
      第 0 行 = 模块名称那一行（标题 + 概览），独立在功能区外面；
      第 1 行 = 功能区（可滚动）。
      提示条不是一个"行"，它是叠在功能区上方的一层（见下面那段注释）。
      标题不再写进任何卡片头。
  -->

  <Grid RowDefinitions="Auto,*" Margin="12,4,12,12">

    <!-- ══════════════════ 顶部：模块名称 ══════════════════ -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" MinHeight="40" Margin="4,0,4,20">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="设置" Classes="pageHeader" />
        
      </StackPanel>
    </Grid>

    <!--
      ★ 功能区是一整张卡（0.3.3）★

      以前这里是十张独立的小卡（每个分组一张），叠在同一个页面上，
      跟其他五页"一整块功能区"的样子不一样 —— 切页时最明显的就是设置页，
      卡片之间有 12px 缝，别人的卡片是连成一片的。

      现在外面套一层 Border.card（Padding=0，内部自己排），
      里面用一条条细分隔线分区，跟「今日工作流」那种"一个大功能区、内部若干区"
      是同一套结构。分组外壳 Border 的圆角归 0，
      再也不能自己长出一张张小卡的形状。
    -->
    <Grid Grid.Row="1">

    <!--
      0.3.4：内外圆角一致 + 内容向内缩。
      外面这张卡是 RadiusCard=18；原来 Padding=0，滚动内容直接顶到卡的边上，
      于是卡是圆的、内容却是直角压着圆角，四个角看起来"缺一块"。
      现在卡留 8px 内边距，里面再套一层同样 18 圆角、裁边界的容器，
      滚动视口自己就是圆角，两层弧线同半径、同方向。
    -->
    <Border Classes="card" Padding="8" ClipToBounds="True">
    <Border CornerRadius="{DynamicResource RadiusCard}" ClipToBounds="True" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!--
      改版后不再有 28px 的页面大标题：设置项本身是 FASettingsExpander，
      每个分组标题（外观 / 专注 / 自习室 …）就是它的"卡片头"，再来个大标题只是重复。
      左右边距跟其他页统一成 12，视觉上六页才是一条线。
    -->
    <StackPanel Margin="0" Spacing="0" HorizontalAlignment="Stretch">

      <!-- ══════════ 外观 ══════════ -->
      <!-- 圆角外壳：FASettingsExpander 模板本身是直角，靠外层 Border 裁圆 -->
      <Border CornerRadius="0" ClipToBounds="True">
        <fa:FASettingsExpander Background="Transparent" Header="外观" Description="明暗、强调色（含自定义调色板）、功能区玻璃浓度"
                             IsExpanded="True">
          <fa:FASettingsExpander.Items>
            <!--
              ── 明暗 ──
              0.3.3 之前这里是"主题"下拉框，里面是九套"明暗 + 固定强调色"的组合。
              现在拆开了：明暗在这里选，颜色在下面选。
              理由见 AppConfig.ColorScheme 的注释 —— 两套东西都想管颜色，
              用户调一个、另一个不听话，是之前"主题色不统一"的根源。
            -->
            <fa:FASettingsExpanderItem Content="明暗模式"
                                       Description="暗色模式下壁纸会自动压一层灰蒙版">
              <fa:FASettingsExpanderItem.Footer>
                <ComboBox ItemsSource="{Binding ColorSchemes}"
                          SelectedItem="{Binding SelectedColorScheme}"
                          MinWidth="200"
                          HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:ColorSchemeOption">
                      <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <!--
              ── 强调色（合并后） ──
              以前这里是三项：强调色来源 / 当前强调色 / 自定义颜色，
              用户得在三个地方之间来回看。现在合成一项：
                最上面选"用哪套颜色"，选了自定义，调色盘才在下面展开。
            -->
            <fa:FASettingsExpanderItem>
              <StackPanel Spacing="12" Width="470" HorizontalAlignment="Left">

                <TextBlock Text="强调色" Classes="section" />

                <ComboBox ItemsSource="{Binding AccentSourceOptions}"
                          SelectedItem="{Binding SelectedAccentSource}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:AccentSourceOption">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Hint}" Opacity="0.55" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 当前生效的颜色：不管选哪种来源都显示，方便对照 -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Border Width="26" Height="26" CornerRadius="6"
                          Background="{Binding EffectiveAccentBrush}"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                  <TextBlock Text="{Binding EffectiveAccentHex}"
                             VerticalAlignment="Center"
                             FontFamily="Consolas, monospace" />
                </StackPanel>

                <!--
                  调色盘：只有选了"自定义颜色"才展开。
                  矩形取色（方块）和 RGB 三条滑块改的是**同一个颜色对象**，
                  所以拖哪边另一边都会跟着动 —— 两者永远是统一的。
                -->
                <StackPanel Spacing="12" IsVisible="{Binding IsCustomAccent}">

                  <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <StackPanel Grid.Column="0" Spacing="8" Width="200">
                      <ctl:SaturationValueSquare Width="200" Height="140"
                                                 HorizontalAlignment="Left"
                                                 Hue="{Binding CustomAccent.Hue}"
                                                 Saturation="{Binding CustomAccent.Saturation}"
                                                 Value="{Binding CustomAccent.Value}" />
                      <ctl:GradientSlider TrackBrush="{Binding CustomAccent.HueTrack}"
                                          Value="{Binding CustomAccent.HueRatio}" />
                      <TextBlock Text="横轴 = 饱和度　纵轴 = 明度" Classes="caption" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Text="{Binding CustomAccent.HexText}" Width="110"
                                 FontFamily="Consolas, monospace" />
                        <Border Width="34" Height="30" CornerRadius="6"
                                Background="{Binding CustomAccent.PreviewBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                      </StackPanel>

                      <ItemsControl ItemsSource="{Binding PresetColors}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Button Classes="swatch"
                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).PickPresetColorCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding}">
                              <Border Width="22" Height="22" CornerRadius="5"
                                      Background="{Binding}" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="24,*,70" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="R" Classes="channelLabel" Foreground="#C42B1C" />
                    <ctl:GradientSlider Grid.Column="1" TrackBrush="{Binding CustomAccent.RedTrack}"
                                        Value="{Binding CustomAccent.RedRatio}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="2" Value="{Binding CustomAccent.RedInt}"
                                   Minimum="0" Maximum="255" Increment="1"
                                   FormatString="0" ShowButtonSpinner="False" />
                  </Grid>

                  <Grid ColumnDefinitions="24,*,70" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="G" Classes="channelLabel" Foreground="#498205" />
                    <ctl:GradientSlider Grid.Column="1" TrackBrush="{Binding CustomAccent.GreenTrack}"
                                        Value="{Binding CustomAccent.GreenRatio}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="2" Value="{Binding CustomAccent.GreenInt}"
                                   Minimum="0" Maximum="255" Increment="1"
                                   FormatString="0" ShowButtonSpinner="False" />
                  </Grid>

                  <Grid ColumnDefinitions="24,*,70" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="B" Classes="channelLabel" Foreground="#0F6CBD" />
                    <ctl:GradientSlider Grid.Column="1" TrackBrush="{Binding CustomAccent.BlueTrack}"
                                        Value="{Binding CustomAccent.BlueRatio}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="2" Value="{Binding CustomAccent.BlueInt}"
                                   Minimum="0" Maximum="255" Increment="1"
                                   FormatString="0" ShowButtonSpinner="False" />
                  </Grid>


                </StackPanel>
              </StackPanel>
            </fa:FASettingsExpanderItem>

            <!--
              ── 功能区（卡片）的玻璃浓度 ──
              100% = 完全不透明。没壁纸时默认 100%（卡片后面空空的，
              半透明只会让它发灰）；一打开壁纸会自动降到 82%，
              想再透一点或者想完全不透，拖这个滑块。
            -->
            <fa:FASettingsExpanderItem Content="功能区不透明度"
                                       Description="100% 完全不透明；有壁纸时会自动降到 82%">
              <fa:FASettingsExpanderItem.Footer>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Slider Value="{Binding CardOpacity}"
                          Minimum="0" Maximum="100"
                          Width="220" />
                  <TextBlock Text="{Binding CardOpacity, StringFormat='{}{0}%'}"
                             VerticalAlignment="Center" Width="46" />
                </StackPanel>
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>
          </fa:FASettingsExpander.Items>

        </fa:FASettingsExpander>
      </Border>

      <!-- ══════════ 背景壁纸 ══════════ -->
      <!-- 圆角外壳：FASettingsExpander 模板本身是直角，靠外层 Border 裁圆 -->
      <Border CornerRadius="0" ClipToBounds="True">
        <fa:FASettingsExpander Background="Transparent" Header="背景壁纸"
                               IsExpanded="False">
          <fa:FASettingsExpander.Items>

            <fa:FASettingsExpanderItem Content="启用背景壁纸">
              <fa:FASettingsExpanderItem.Footer>
                <ToggleSwitch IsChecked="{Binding WallpaperEnabled}" OnContent="开" OffContent="关" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem Content="壁纸图片"
                             Description="{Binding WallpaperStatusText}">
              <fa:FASettingsExpanderItem.Footer>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding WallpaperPath}" Width="300"
                           />
                  <Button Content="浏览…" Click="OnBrowseWallpaper" />
                  <Button Content="清除" Command="{Binding ClearWallpaperCommand}" />
                </StackPanel>
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem Content="蒙版浓度"
                                       Description="把壁纸压淡一点，字就看得清。颜色跟着明暗：亮色用白提亮，暗色用黑压暗，暗色下会自动加强。">
              <fa:FASettingsExpanderItem.Footer>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Slider Value="{Binding WallpaperScrimOpacity}"
                          Minimum="0" Maximum="100"
                          Width="220" />
                  <TextBlock Text="{Binding WallpaperScrimOpacity, StringFormat='{}{0}%'}"
                             VerticalAlignment="Center" Width="46" />
                </StackPanel>
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem Content="模糊强度">
              <fa:FASettingsExpanderItem.Footer>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Slider Value="{Binding WallpaperBlurRadius}"
                          Minimum="0" Maximum="60"
                          Width="220" />
                  <TextBlock Text="{Binding WallpaperBlurRadius, StringFormat='{}{0} px'}"
                             VerticalAlignment="Center" Width="46" />
                </StackPanel>
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

          </fa:FASettingsExpander.Items>
        </fa:FASettingsExpander>
      </Border>

      <!-- ══════════ 专注 ══════════ -->
      <!-- 圆角外壳：FASettingsExpander 模板本身是直角，靠外层 Border 裁圆 -->
      <Border CornerRadius="0" ClipToBounds="True">
        <fa:FASettingsExpander Background="Transparent" Header="专注" Description="番茄钟时长与休息规则"
                             IsExpanded="True">
          <fa:FASettingsExpander.Items>
            <fa:FASettingsExpanderItem Content="默认专注时长（分钟）">
              <fa:FASettingsExpanderItem.Footer>
                <NumericUpDown Value="{Binding Config.DefaultFocusMinutes}"
                               Minimum="1" Maximum="480" Increment="5"
                               FormatString="0" MinWidth="130" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem Content="短休息（分钟）">
              <fa:FASettingsExpanderItem.Footer>
                <NumericUpDown Value="{Binding Config.BreakMinutes}"
                               Minimum="1" Maximum="60" Increment="1"
                               FormatString="0" MinWidth="130" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem Content="长休息（分钟）">
              <fa:FASettingsExpanderItem.Footer>
                <NumericUpDown Value="{Binding Config.LongBreakMinutes}"
                               Minimum="1" Maximum="120" Increment="5"
                               FormatString="0" MinWidth="130" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem Content="专注结束后自动进入休息">
              <fa:FASettingsExpanderItem.Footer>
                <ToggleSwitch IsChecked="{Binding Config.FocusCompletionAlert}" OnContent="开" OffContent="关" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>
          </fa:FASettingsExpander.Items>
        </fa:FASettingsExpander>
      </Border>

      <!-- ══════════ 自控模块 ══════════ -->
      <!-- 圆角外壳：FASettingsExpander 模板本身是直角，靠外层 Border 裁圆 -->
      <Border CornerRadius="0" ClipToBounds="True">
        <fa:FASettingsExpander Background="Transparent" Header="自控模块" 
                             IsExpanded="True">

          <fa:FASettingsExpander.Items>
            <fa:FASettingsExpanderItem Content="启用专注守护">
              <fa:FASettingsExpanderItem.Footer>
                <ToggleSwitch IsChecked="{Binding Config.EnableFocusGuard}" OnContent="开" OffContent="关" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem Content="容忍次数">
              <fa:FASettingsExpanderItem.Footer>
                <NumericUpDown Value="{Binding Config.FocusGuardTolerance}"
                               Minimum="0" Maximum="20" Increment="1"
                               FormatString="0" MinWidth="130" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>
          </fa:FASettingsExpander.Items>
        </fa:FASettingsExpander>
      </Border>

      <!-- ══════════ 每日工作流 ══════════ -->
      <!-- 圆角外壳：FASettingsExpander 模板本身是直角，靠外层 Border 裁圆 -->
      <Border CornerRadius="0" ClipToBounds="True">
        <fa:FASettingsExpander Background="Transparent" Header="每日工作流" Description="24 小时时间轴的显示方式"
                             IsExpanded="True">
          <fa:FASettingsExpander.Items>
            <fa:FASettingsExpanderItem Content="超载阈值（小时）"
                                       Description="一天安排超过这么多小时，就在时间轴右边提示“今天有点满”。">
              <fa:FASettingsExpanderItem.Footer>
                <NumericUpDown Value="{Binding Config.OverloadHours}"
                               Minimum="1" Maximum="24" Increment="1"
                               FormatString="0" MinWidth="130" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem Content="时间轴上显示已完成"
                                       Description="关掉之后，已完成的日程和待办不再画在 24 小时时间轴上，画面更干净。">
              <fa:FASettingsExpanderItem.Footer>
                <ToggleSwitch IsChecked="{Binding Config.ShowCompletedOnTimeline}" OnContent="开" OffContent="关" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>
          </fa:FASettingsExpander.Items>
        </fa:FASettingsExpander>
      </Border>

      <!-- ══════════ 自习室 ══════════ -->
      <!-- 圆角外壳：FASettingsExpander 模板本身是直角，靠外层 Border 裁圆 -->
      <Border CornerRadius="0" ClipToBounds="True">
        <fa:FASettingsExpander Background="Transparent" Header="自习室" Description="昵称与默认专注时长"
                             IsExpanded="True">
          <fa:FASettingsExpander.Items>
            <fa:FASettingsExpanderItem Content="昵称">
              <fa:FASettingsExpanderItem.Footer>
                <TextBox Text="{Binding Config.DisplayName}" MinWidth="180" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem Content="自习室默认专注时长（分钟）">
              <fa:FASettingsExpanderItem.Footer>
                <NumericUpDown Value="{Binding Config.StudyRoomFocusMinutes}"
                               Minimum="5" Maximum="480" Increment="5"
                               FormatString="0" MinWidth="130" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem Content="局域网联机">
              <fa:FASettingsExpanderItem.Footer>
                <ToggleSwitch IsChecked="{Binding EnableNetworkStudyRoom}"
                              OnContent="已开启" OffContent="已关闭" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>
          </fa:FASettingsExpander.Items>
        </fa:FASettingsExpander>
      </Border>

      <!-- ══════════ 数据与文件 ══════════ -->
      <!-- 圆角外壳：FASettingsExpander 模板本身是直角，靠外层 Border 裁圆 -->
      <Border CornerRadius="0" ClipToBounds="True">
        <fa:FASettingsExpander Background="Transparent" Header="数据与文件" Description="配置文件、数据库、备份"
                             IsExpanded="True">
          <fa:FASettingsExpander.Items>
            <fa:FASettingsExpanderItem Content="配置文件"
                             Description="{Binding ConfigFilePath}">
              <fa:FASettingsExpanderItem.Footer>
                <Button Content="打开文件夹" Command="{Binding OpenConfigFolderCommand}" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

         

            <fa:FASettingsExpanderItem Content="启动时自动备份">
              <fa:FASettingsExpanderItem.Footer>
                <ToggleSwitch IsChecked="{Binding Config.AutoBackup}" OnContent="开" OffContent="关" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem Content="导出 / 导入">
              <fa:FASettingsExpanderItem.Footer>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="导出…" Click="OnExportBackup"
                          IsEnabled="{Binding !IsBackupBusy}" />
                  <Button Content="导入…" Click="OnImportBackup"
                          IsEnabled="{Binding !IsBackupBusy}" />
                </StackPanel>
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem Content="备份文件夹"
                             Description="{Binding BackupDirectory}">
              <fa:FASettingsExpanderItem.Footer>
                <Button Content="打开文件夹" Command="{Binding OpenBackupFolderCommand}" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem Content="最近一次备份操作"
                             Description="{Binding BackupStatusText}" />
          </fa:FASettingsExpander.Items>
        </fa:FASettingsExpander>
      </Border>

      <!-- ══════════ 底层设置 ══════════ -->
      <!--
        这一组默认收起，并且明确写"如非遇到渲染问题，请勿调整"。
        原因：渲染后端不是功能开关，而是"界面画不出来时的救命绳"——
        正常情况软件渲染最省内存，调错了最多是更费资源；
        但把它当成"性能调节"随手改，反而容易撞上看不清界面的问题。
      -->
      <!-- 圆角外壳：FASettingsExpander 模板本身是直角，靠外层 Border 裁圆 -->
      <Border CornerRadius="0" ClipToBounds="True">
        <fa:FASettingsExpander Background="Transparent" Header="底层设置"
                               Description="如非遇到渲染问题，请勿调整！"
                               IsExpanded="False">
          <fa:FASettingsExpander.Items>

            <fa:FASettingsExpanderItem Content="渲染后端"
                                       Description="{Binding RenderBackendStatusText}">
              <fa:FASettingsExpanderItem.Footer>
                <StackPanel Spacing="6" HorizontalAlignment="Right">
                  <ComboBox ItemsSource="{Binding RenderBackends}"
                            SelectedItem="{Binding SelectedRenderBackend}"
                            MinWidth="260"
                            HorizontalAlignment="Right">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:RenderBackendOption">
                        <TextBlock Text="{Binding DisplayText}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="改完需要重启程序才生效。"
                             Classes="caption"
                             HorizontalAlignment="Right" />
                </StackPanel>
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

          </fa:FASettingsExpander.Items>
        </fa:FASettingsExpander>
      </Border>

      <!-- ══════════ 插件 ══════════ -->
      <!-- 圆角外壳：FASettingsExpander 模板本身是直角，靠外层 Border 裁圆 -->
      <Border CornerRadius="0" ClipToBounds="True">
        <fa:FASettingsExpander Background="Transparent" Header="插件"
                             IsExpanded="True">
          <fa:FASettingsExpander.Items>

            <fa:FASettingsExpanderItem Content="状态"
                             Description="插件接口在本版本中暂时关闭。我们正在重新设计插件规范（可暴露的接口类型、权限与版本兼容策略），完成后再开放。已有的插件目录不会被读取，也不会执行。" />

          </fa:FASettingsExpander.Items>
        </fa:FASettingsExpander>
      </Border>

      <!-- ══════════ 关于 + 操作 ══════════ -->
      <!-- 圆角外壳：FASettingsExpander 模板本身是直角，靠外层 Border 裁圆 -->
      <Border CornerRadius="0" ClipToBounds="True">
        <fa:FASettingsExpander Background="Transparent" Header="关于" Description="Helium Todo 日程！ 专注！ 自动化！"
                             IsExpanded="True">
          <fa:FASettingsExpander.Items>
            <fa:FASettingsExpanderItem Content="版本">
              <fa:FASettingsExpanderItem.Footer>
                <TextBlock Text="{Binding AppVersion}" VerticalAlignment="Center" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>
            <fa:FASettingsExpanderItem Content="恢复默认设置">
              <fa:FASettingsExpanderItem.Footer>
                <Button Content="恢复默认" Command="{Binding ResetToDefaultCommand}" />
              </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>
          </fa:FASettingsExpander.Items>
        </fa:FASettingsExpander>
      </Border>

      <!-- 保存按钮 -->
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
        <Button Content="保存设置" Classes="accent" MinWidth="120"
                HorizontalContentAlignment="Center"
                Command="{Binding SaveCommand}" />
        <TextBlock Text="修改主题会立刻生效，其它设置点「保存设置」后写入文件。"
                   Classes="caption" VerticalAlignment="Center" />
      </StackPanel>

    </StackPanel>
    </ScrollViewer>
    </Border>
    </Border>

    <!-- ══════════ 导入确认浮层 ══════════ -->
    <!-- 替换导入会清空现有数据，所以先停下来问一句，把"要拿什么换什么"摊开给用户看 -->
    <Border IsVisible="{Binding IsImportConfirmOpen}" Background="#66000000">
      <Border Classes="card" MaxWidth="580" Padding="22" Margin="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="导入这份备份？" Classes="section" />

          <TextBlock Text="{Binding ImportFileName}" FontWeight="SemiBold" TextWrapping="Wrap" />

          <TextBlock Text="{Binding ImportSummaryText}" Classes="caption" TextWrapping="Wrap" />

          <Border IsVisible="{Binding HasImportWarning}"
                  Background="{DynamicResource ConflictErrorFillBrush}"
                  CornerRadius="6" Padding="10,8">
            <TextBlock Text="{Binding ImportWarningText}"
                       Foreground="{DynamicResource ConflictErrorBrush}"
                       TextWrapping="Wrap" />
          </Border>

          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="注意，选择替换会覆盖原有数据！" />

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="取消" Command="{Binding CancelImportCommand}" />
            <Button Content="合并导入" Classes="accent"
                    Command="{Binding ImportMergeCommand}"
                    IsEnabled="{Binding !IsBackupBusy}" />
            <Button Content="替换导入"
                    Command="{Binding ImportReplaceCommand}"
                    IsEnabled="{Binding !IsBackupBusy}"
                    Background="{DynamicResource ConflictErrorFillBrush}"
                    Foreground="{DynamicResource ConflictErrorBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!--
      提示条：**叠在功能区上方**，不占行、不把内容往下推。

      【为什么从"占一行"又改回"叠"？】
        上一版为了避免"底下的字透出来"，让它单独占一行、把内容推开。
        那样每弹一次提示，整页设置就往下蹦一次 —— 用户正在拖的滑块
        会从手指底下溜走，比"透字"更难受。
        真正的根因不是"叠"，是"半透明底 + 底下的字透出来"。
        所以现在：叠在上面，但底板是**不透明**的主题色
        （NoticeSurfaceBrush 在亮/暗两套主题字典里各有一份，自己跟着明暗走），
        底下透不出来，也就不会再"层级错乱"。

      3 秒后自己收起来（时长在 Core 的 NoticePolicy 里，单测锁着），
      右边还有一个 × 可以立刻关。
    -->
    <Border Name="NoticeBar"
            IsVisible="{Binding IsNoticeVisible}"
            VerticalAlignment="Top"
            Margin="12,10,12,0"
            Padding="14,10"
            CornerRadius="{DynamicResource RadiusCard}"
            Background="{DynamicResource NoticeSurfaceBrush}"
            BorderBrush="{DynamicResource NoticeBorderBrush}"
            BorderThickness="1"
            BoxShadow="{DynamicResource CardShadow}"
            ZIndex="10">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <TextBlock Grid.Column="0"
                   Text="&#xE73E;"
                   FontFamily="{DynamicResource IconFont}"
                   FontSize="14"
                   Margin="0,0,10,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource NoticeIconBrush}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding NoticeText}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource NoticeForegroundBrush}" />
        <Button Grid.Column="2"
                Width="28" Height="28"
                Margin="8,0,0,0"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                ToolTip.Tip="关闭"
                Command="{Binding HideNoticeCommand}">
          <TextBlock Text="&#xE711;"
                     FontFamily="{DynamicResource IconFont}"
                     FontSize="10"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource NoticeForegroundBrush}" />
        </Button>
      </Grid>
    </Border>

    </Grid>

    <!--
      重启确认浮层。

      为什么不弹独立窗口（ContentDialog / ShowDialog）：
        这个程序做过窗口层级的自绘（无边框 + 自绘抓手），另开一个顶层窗口在这种
        结构下容易被主窗口盖住、或者抢走焦点导致主窗口失活；而无头自检里
        也没有真正的模态窗口可点。这里用一个铺满页面的 Border 当遮罩，
        行为完全可预测，截图自检也能直接断言。

      两个按钮的语义要分清：
        · 确认     → 保存配置并立刻重启（新进程才会读新后端）
        · 取消更改 → 一个字都不写，下拉框退回原来的值
    -->
    <Border IsVisible="{Binding IsRestartPromptVisible}"
            Background="#66000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Border Classes="card"
              MaxWidth="420"
              Padding="24"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="更改此项需要重启，是否立即重启"
                     FontSize="16"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Classes="caption"
                     TextWrapping="Wrap"
                     Text="「确认」会保存选择并立刻重新启动 Helium Todo；「取消更改」则保持现在的设置不变。" />
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="确认"
                    Classes="accent"
                    MinWidth="96"
                    Command="{Binding ConfirmBackendRestartCommand}" />
            <Button Content="取消更改"
                    MinWidth="96"
                    Command="{Binding CancelBackendChangeCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</UserControl>
