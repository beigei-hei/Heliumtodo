<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeliumTodo.Desktop.ViewModels"
             xmlns:b="using:HeliumTodo.Desktop.Behaviors"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             x:Class="HeliumTodo.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="Transparent">

  <!--
    ══════════════════════════════════════════════════════════════════════════
      应用外壳
    ══════════════════════════════════════════════════════════════════════════
    改版后的结构（从上到下、从左到右）：

      ┌──────────────────────────────────────────────────────────────┐
      │ 标题栏 48px：品牌                             状态  ─ □ ✕   │  ← 自己画的
      ├────┬─────────────────────────────────────────┬───────────────┤
      │导  │                                         │               │
      │航  │        当前页面（卡片浮在壁纸上）        │   右侧栏      │
      │轨  │                                         │  （各页自备） │
      │56  │                                         │               │
      └────┴─────────────────────────────────────────┴───────────────┘

    为什么自己画标题栏：原生标题栏是系统画的，颜色跟壁纸永远对不上，
    顶上会突然出现一条灰色横条。改成"无边框 + 自绘"之后，壁纸能一直铺到窗口顶端。

    为什么导航从 FANavigationView 换成自绘图标轨：
      ① FANavigationView 展开态是 228px 的文字导航，收成 56px 纯图标要额外的显示模式切换；
      ② 它自带的命令栏、返回按钮、页头在窄轨里全是多余的；
      ③ 自绘只有几十行，选中态完全可控（强调色实心块 + 白色图标）。
      代价：键盘导航要自己保证 —— 所以每个条目仍然是真正的 Button，
      焦点、回车触发都还在。
  -->

  <UserControl.Resources>

    <!--
      图标轨里一个按钮：圆角 12、选中时强调色实心。

      Width 显式设成 NaN（= 不指定），让按钮跟着轨道的可用宽度自己涨落。
      【为什么不给按钮也挂一条 Width 过渡】
        轨道本身已经在动，按钮只要"填满"，位置自然跟得上 —— 不需要第二条动画。
        以前这里各挂一条 260ms 的 Width 过渡，于是每帧有 1 + N 条动画各自改一次宽度，
        每次都让整页重新测量；肉眼看到的就是"拉的时候一卡一卡"。
        现在全窗口只有一条属性在动（轨道 Width），按钮是被动跟随。
    -->
    <DataTemplate x:Key="RailItemTemplate" DataType="vm:NavigationItemViewModel">
      <Button Classes="railItem"
              Classes.active="{Binding IsSelected}"
              Classes.expanded="{Binding IsExpanded}"
              Tag="{Binding}"
              HorizontalContentAlignment="Left"
              Click="OnRailItemClick"
              ToolTip.Tip="{Binding Title}">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="13,0" HorizontalAlignment="Left">
          <TextBlock Classes="railGlyph"
                     Text="{Binding Icon}"
                     FontFamily="{DynamicResource IconFont}" />
          <TextBlock Classes="railLabel"
                     Text="{Binding Title}"
                     Opacity="{Binding RailLabelOpacity}">
            <!-- 名称淡入淡出跟上轨道宽度。Opacity 不改布局，所以这条过渡每帧
                 只是写一个属性；它不能放进样式（样式里的 Transitions 会让
                 XAML 编译器内部报错），只能写在控件上。 -->
            <TextBlock.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="{Binding RailAnimationDuration}">
                  <DoubleTransition.Easing>
                    <CubicEaseOut />
                  </DoubleTransition.Easing>
                </DoubleTransition>
              </Transitions>
            </TextBlock.Transitions>
          </TextBlock>
        </StackPanel>
      </Button>
    </DataTemplate>

  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">

    <!-- ══════════ 标题栏 ══════════ -->
    <Border Grid.Row="0"
            x:Name="TitleBar"
            Height="{DynamicResource TitleBarHeight}"
            Background="Transparent">

      <i:Interaction.Behaviors>
        <b:DragWindowBehavior />
        <b:ToggleMaximizeBehavior />
      </i:Interaction.Behaviors>

      <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0,8,0">

        <!-- 品牌区 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" IsHitTestVisible="False">
          <Border Width="24" Height="24" CornerRadius="7"
                  Background="{DynamicResource SystemAccentColor}">
            <TextBlock Text="H" FontWeight="Bold" FontSize="13" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Helium Todo" FontWeight="SemiBold" FontSize="13"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding VersionText}" FontSize="10" Opacity="0.5"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- 中间：当前页面的加载状态 / 冲突提醒。
             放在标题栏而不是内容区，是为了不占卡片的高度 —— 它本来就只是一行提示。 -->
        <TextBlock Grid.Column="1"
                   Text="{Binding StatusText}"
                   FontSize="12" Opacity="0.55"
                   VerticalAlignment="Center" Margin="16,0,0,0"
                   IsHitTestVisible="False" />

        <!-- 窗口按钮：自己画，才能和壁纸配色统一 -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                    VerticalAlignment="Center">
          <Button Classes="windowButton" ToolTip.Tip="最小化">
            <i:Interaction.Behaviors>
              <b:WindowStateBehavior Action="Minimize" />
            </i:Interaction.Behaviors>
            <TextBlock Text="&#xE921;" FontFamily="{DynamicResource IconFont}" FontSize="10" />
          </Button>
          <Button Classes="windowButton" ToolTip.Tip="最大化 / 还原">
            <i:Interaction.Behaviors>
              <b:WindowStateBehavior Action="Maximize" />
            </i:Interaction.Behaviors>
            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{DynamicResource IconFont}" FontSize="10">
              <i:Interaction.Behaviors>
                <b:WindowStateGlyphBehavior />
              </i:Interaction.Behaviors>
            </TextBlock>
          </Button>
          <Button Classes="windowButton close" ToolTip.Tip="关闭">
            <i:Interaction.Behaviors>
              <b:WindowStateBehavior Action="Close" />
            </i:Interaction.Behaviors>
            <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource IconFont}" FontSize="10" />
          </Button>
        </StackPanel>

      </Grid>
    </Border>

    <!-- ══════════ 主体：图标轨 + 内容区 ══════════ -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

      <!-- ───── 左侧图标轨 ───── -->
      <Border Grid.Column="0"
              Name="NavRail"
              Width="{Binding RailWidth}"
              Margin="8,0,4,8"
              CornerRadius="{DynamicResource RadiusCard}"
              Background="{DynamicResource CardSurfaceBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="1"
              BoxShadow="{DynamicResource CardShadow}"
              ClipToBounds="True">

        <!--
          轨道宽度上的过渡就是需求里说的"拉伸非线性动效"：
          CubicEaseOut = 起步快、收尾慢（Windows 自己的展开动画也是这个手感），
          0.26 秒比页面切换（0.18）略长一点，才看得出"拉"的过程。
        -->
        <!-- 时长绑 VM 的 RailAnimationDuration（源头是 Core 的 RailMetrics.AnimationDurationMs）：
             降质时长、自检断言读的都是同一个数，改一次就全改。 -->
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="{Binding RailAnimationDuration}">
              <DoubleTransition.Easing>
                <CubicEaseOut />
              </DoubleTransition.Easing>
            </DoubleTransition>
          </Transitions>
        </Border.Transitions>

        <DockPanel Margin="0,6,0,8">
          <!-- 展开 / 收起按钮：钉在轨道顶部，永远是第一个能点到的东西 -->
          <Button DockPanel.Dock="Top"
                  Classes="railToggle"
                  ToolTip.Tip="展开 / 收起功能名">
            <i:Interaction.Behaviors>
              <b:ToggleRailBehavior />
            </i:Interaction.Behaviors>
            <TextBlock Text="{Binding RailToggleGlyph}"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="11" />
          </Button>

          <!-- 底部条目：现在空着（设置已上移），留给将来的账户/状态 -->
          <ItemsControl DockPanel.Dock="Bottom"
                        ItemsSource="{Binding FooterItems}"
                        ItemTemplate="{StaticResource RailItemTemplate}" />

          <ItemsControl ItemsSource="{Binding MenuItems}"
                        ItemTemplate="{StaticResource RailItemTemplate}" />
        </DockPanel>
      </Border>

      <!-- ───── 内容区 ───── -->
      <Grid Grid.Column="1">
        <ContentControl Content="{Binding CurrentPage}" />
      </Grid>

    </Grid>

    <!--
      ───── 提醒浮层（错误 / 冲突） ─────
      贴在窗口右下角、浮在内容之上，不占布局行。

      【为什么不放在内容区顶部】
        P4 之前它是一条整行 Border，数据库连不上时两行长文案会把页面整体压低，
        遮住标题栏右侧的窗口按钮，也挡住内容区的第一行。改成小卡片后：
        宽度有上限、最多三行、悬停可看全文，只盖住右下角一块。

      【为什么留在 XAML 里而不是用系统通知】
        自检需要能按名字找到它、量它的位置和宽度；系统通知在无头环境里不存在。
    -->
    <Border Grid.RowSpan="2"
            x:Name="AlertToast"
            ZIndex="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,20,20"
            MaxWidth="440"
            Padding="14,10"
            CornerRadius="10"
            Background="{DynamicResource NoticeSurfaceBrush}"
            BorderBrush="{DynamicResource NoticeBorderBrush}"
            BorderThickness="1"
            BoxShadow="0 10 30 0 #33000000"
            IsVisible="{Binding IsAlertVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Text="&#xE7BA;"
                   FontFamily="{DynamicResource IconFont}"
                   FontSize="14"
                   Foreground="#FFB900"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding AlertMessage}"
                   Foreground="{DynamicResource NoticeForegroundBrush}"
                   TextWrapping="Wrap"
                   MaxLines="3"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding AlertDetail}"
                   VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Width="24" Height="24"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="6"
                Command="{Binding DismissAlertCommand}"
                ToolTip.Tip="收起提醒"
                VerticalAlignment="Top">
          <TextBlock Text="&#xE8BB;"
                     FontFamily="{DynamicResource IconFont}"
                     FontSize="10"
                     Foreground="{DynamicResource NoticeForegroundBrush}"
                     Opacity="0.65" />
        </Button>
      </Grid>
    </Border>

  </Grid>
</UserControl>