<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HeliumTodo.Desktop —— Avalonia 桌面界面
    Material 3 设计系统（0.5.0 起）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HeliumTodo.Desktop</RootNamespace>
    <AssemblyName>HeliumTodo.Desktop</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!--
      Avalonia 12 把文字排版（HarfBuzz 整形）拆成了独立包。
      Avalonia 11 时代它埋在 Skia 里，所以老代码里看不到这个引用。
    -->
    <PackageReference Include="Avalonia.HarfBuzz" />
    <!--
      设计系统：FluentAvalonia（0.5.0-alpha 热修 2 起）。
      Material 3 试用后按用户反馈切回；设置页与提示条是自绘的，不依赖设计系统。
    -->
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- XAML behaviors（0.5.0 P5）：Interaction.Behaviors 的官方实现。 -->
    <PackageReference Include="Xaml.Behaviors.Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- 自己解码壁纸的每一帧（APNG / GIF），需要直接调 Skia 的 API -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <!--
    ⚠️ Avalonia 12 删掉了 Avalonia.Diagnostics 这个包（开发者工具窗口）。
       我们已经把它从引用里去掉。
       反正代码里从来没调用过 AttachDevTools()，等于只是个挂在依赖里的空引用。

       以后要调试界面，Avalonia 12 改用 Avalonia DevTools 独立工具。
  -->

  <ItemGroup>
    <ProjectReference Include="..\HeliumTodo.Application\HeliumTodo.Application.csproj" />
    <ProjectReference Include="..\HeliumTodo.Domain\HeliumTodo.Domain.csproj" />
    <!-- Infrastructure 只允许在组合根（Composition/App.axaml.cs）里出现 -->
    <ProjectReference Include="..\HeliumTodo.Infrastructure\HeliumTodo.Infrastructure.csproj" />
  </ItemGroup>

</Project>
